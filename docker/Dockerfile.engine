# Moteur NounoursAutoRegie pour le Proxmox (Docker / Portainer).
# Construction depuis la racine du dépôt :
#   docker build -f docker/Dockerfile.engine -t nounoursautoregie-engine .
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src
COPY Directory.Build.props NounoursAutoRegie.sln ./
COPY src/NAR.Core/NAR.Core.csproj src/NAR.Core/
COPY src/NAR.Engine/NAR.Engine.csproj src/NAR.Engine/
RUN dotnet restore src/NAR.Engine/NAR.Engine.csproj
COPY src/ src/
RUN dotnet publish src/NAR.Engine/NAR.Engine.csproj -c Release -o /app --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:8.0
RUN apt-get update \
 && apt-get install -y --no-install-recommends ffmpeg \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /app .
# /config : channel.json  —  /media : vos fichiers  —  /data : HLS + journal de diffusion
VOLUME ["/config", "/media", "/data"]
EXPOSE 8090
ENV NAR_CONFIG=/config/channel.json
ENTRYPOINT ["dotnet", "NAR.Engine.dll"]
