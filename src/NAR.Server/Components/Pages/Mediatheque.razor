@page "/mediatheque"
@rendermode InteractiveServer
@implements IDisposable
@inject IDbContextFactory<NarDbContext> DbFactory
@inject MediaLibrary Library
@inject NAR.Server.Services.Network.NetworkScanner Scanner
@inject NAR.Server.Services.Network.SmbSources Smb
@using NAR.Server.Services.Network

<PageTitle>Médiathèque — NounoursAutoRegie</PageTitle>

<h1>Médiathèque</h1>
<p class="lead">Chaque média est analysé une fois pour toutes : durée, format, volume (correction automatique vers −23 LUFS) et vignette.</p>

@if (_message is not null) { <div class="alert @(_messageOk ? "ok" : "error")">@_message</div> }

<h2>Dossiers surveillés</h2>
<div class="panel">
    @if (_folders.Count == 0)
    {
        <p class="muted" style="margin-top:0">Aucun dossier. Ajoutez le chemin d'un dossier de vidéos tel qu'il est vu par le serveur (ex. <span class="mono">/media/films</span> ou <span class="mono">D:\Vidéos</span>).</p>
    }
    else
    {
        <table class="grid" style="margin-bottom:14px">
            <thead><tr><th>Chemin</th><th>Type par défaut</th><th>Fichiers</th><th>Dernier parcours</th><th></th></tr></thead>
            <tbody>
                @foreach (var f in _folders)
                {
                    <tr>
                        <td>
                            @if (f.Source == FolderSource.Smb) { <span class="badge info" style="margin-right:6px">Partage Windows</span> }
                            @if (f.Source == FolderSource.Jellyfin)
                            {
                                <span class="badge info" style="margin-right:6px">Jellyfin</span>
                                <span>@f.RemoteLibraryName</span> <span class="mono small muted">@f.RemoteUrl</span>
                            }
                            else
                            {
                                <span class="mono small">@f.Path @(f.Recursive ? "" : "(sans sous-dossiers)")</span>
                            }
                            @if (f.LastScanError is not null) { <div class="small" style="color:var(--live)">@f.LastScanError</div> }
                        </td>
                        <td>@Fmt.Kind(f.DefaultKind)</td>
                        <td class="num">@f.LastScanCount</td>
                        <td class="small">@(f.LastScanAt is { } at ? at.ToLocalTime().ToString("dd/MM HH:mm") : "—")</td>
                        <td>
                            <div class="row" style="@(CanEdit ? "" : "display:none")">
                                <button class="btn sm" disabled="@_busy" @onclick="() => ScanAsync(f.Id)">Parcourir</button>
                                <button class="btn sm danger" @onclick="() => RemoveFolderAsync(f.Id)">Retirer</button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    @if (CanEdit)
    {
    <div class="row">
        <input class="grow" placeholder="Chemin du dossier" @bind="_newPath" />
        <select @bind="_newKind">
            @foreach (var k in Enum.GetValues<AssetKind>())
            {
                <option value="@k">@Fmt.Kind(k)</option>
            }
        </select>
        <label class="check"><input type="checkbox" @bind="_newRecursive" /> Sous-dossiers</label>
        <button class="btn primary" disabled="@_busy" @onclick="AddFolderAsync">Ajouter</button>
    </div>
    }
</div>

@if (CanEdit)
{

<h2>Partage d'un PC Windows</h2>
<div class="panel">
    <p class="muted" style="margin-top:0">La régie lit directement le dossier partagé du PC par le réseau : rien à monter sur le Proxmox.
        Sur le PC : clic droit sur le dossier → Propriétés → Partage → Partage avancé → « Partager ce dossier ».</p>

    <div class="row" style="margin-bottom:12px">
        <button class="btn" disabled="@_scanning" @onclick="ScanNetworkAsync">@(_scanning ? "Recherche en cours…" : "Rechercher les PC du réseau")</button>
        <span class="muted">ou</span>
        <input placeholder="Adresse IP ou nom du PC" @bind="_smbHost" @bind:event="oninput" style="width:220px" />
    </div>

    @if (_hosts is not null)
    {
        @if (_hosts.Count == 0)
        {
            <p class="muted">Aucun PC ne partage de fichiers sur le réseau (port 445). Vérifiez que le partage est activé et que le pare-feu Windows l'autorise (réseau « privé »).</p>
        }
        else
        {
            <div class="row" style="margin-bottom:12px">
                @foreach (var h in _hosts)
                {
                    <button class="btn @(_smbHost == h.Address ? "primary" : "")" @onclick="() => ChooseHost(h)">
                        🖥 @(h.Name ?? h.Address) @if (h.Name is not null) { <span class="small" style="opacity:.7">@h.Address</span> }
                    </button>
                }
            </div>
        }
    }

    @if (!string.IsNullOrWhiteSpace(_smbHost))
    {
        <div class="form-grid">
            <label class="field"><span>Identifiant Windows</span><input @bind="_smbUser" autocomplete="off" placeholder="compte local, ou adresse e-mail Microsoft" /></label>
            <label class="field"><span>Mot de passe</span><input type="password" @bind="_smbPassword" autocomplete="new-password" /></label>
            <div style="align-self:end"><button class="btn" disabled="@_busy" @onclick="ListSharesAsync">Afficher les partages</button></div>
        </div>
    }

    @if (_shares is not null)
    {
        <div class="row" style="margin:12px 0">
            <span class="muted">Partages :</span>
            @foreach (var share in _shares)
            {
                <button class="btn sm @(_smbShare == share ? "primary" : "")" @onclick="() => _smbShare = share">📁 @share</button>
            }
            @if (_shares.Count == 0) { <span class="muted">aucun dossier partagé sur ce PC.</span> }
        </div>
    }

    @if (_smbShare is not null)
    {
        <div class="form-grid">
            <label class="field"><span>Sous-dossier (facultatif)</span><input @bind="_smbSubPath" placeholder="ex. Films/Animation" /></label>
            <label class="field"><span>Type par défaut</span>
                <select @bind="_smbKind">
                    @foreach (var k in Enum.GetValues<AssetKind>()) { <option value="@k">@Fmt.Kind(k)</option> }
                </select>
            </label>
            <label class="check" style="align-self:end"><input type="checkbox" @bind="_smbRecursive" /> Sous-dossiers</label>
            <div style="align-self:end"><button class="btn primary" disabled="@_busy" @onclick="AddSmbFolderAsync">Ajouter à la médiathèque</button></div>
        </div>
    }
</div>

<h2>Jellyfin</h2>
<div class="panel">
    <p class="muted" style="margin-top:0">Importe les films et les séries d'un serveur Jellyfin, avec leurs résumés, saisons et épisodes.
        Créez une clé dans Jellyfin : Tableau de bord → Clés API → « + ».</p>
    <div class="form-grid">
        <label class="field"><span>Adresse du serveur</span><input @bind="_jfUrl" placeholder="http://192.168.1.10:8096" /></label>
        <label class="field"><span>Clé API</span><input type="password" @bind="_jfKey" autocomplete="off" /></label>
        <div style="align-self:end"><button class="btn" disabled="@_busy" @onclick="ConnectJellyfinAsync">Se connecter</button></div>
    </div>
    @if (_jfLibraries is not null)
    {
        <p style="margin:14px 0 8px">Serveur <b>@_jfServerName</b> — bibliothèques à importer :</p>
        <div class="row" style="margin-bottom:12px">
            @foreach (var lib in _jfLibraries)
            {
                <label class="check panel" style="padding:8px 12px">
                    <input type="checkbox" checked="@_jfSelected.Contains(lib.Id)" @onchange="e => ToggleLibrary(lib.Id, e.Value is true)" />
                    @lib.Name <span class="small muted">@LibraryLabel(lib.CollectionType)</span>
                </label>
            }
        </div>
        <button class="btn primary" disabled="@(_busy || _jfSelected.Count == 0)" @onclick="ImportJellyfinAsync">Importer dans la médiathèque</button>
    }
</div>

}

<h2>Médias <span class="muted" style="text-transform:none">(@_total)</span></h2>
<div class="row" style="margin-bottom:10px">
    <input class="grow" placeholder="Rechercher un titre ou un fichier…" @bind="Search" @bind:event="oninput" @bind:after="ReloadAsync" />
    <select @bind="KindFilter" @bind:after="ReloadAsync">
        <option value="">Tous les types</option>
        @foreach (var k in Enum.GetValues<AssetKind>())
        {
            <option value="@k">@Fmt.Kind(k)</option>
        }
    </select>
    <select @bind="StatusFilter" @bind:after="ReloadAsync">
        <option value="">Tous les états</option>
        @foreach (var s in Enum.GetValues<AssetStatus>())
        {
            <option value="@s">@Fmt.Status(s).Label</option>
        }
    </select>
</div>

<div class="table-wrap">
    <table class="grid">
        <thead><tr><th></th><th>Titre</th><th>Type</th><th>Durée</th><th>Format</th><th>Volume</th><th>État</th><th></th></tr></thead>
        <tbody>
            @foreach (var a in _assets)
            {
                var (label, css) = Fmt.Status(a.Status);
                <tr @key="a.Id">
                    <td>
                        @if (a.HasThumbnail)
                        {
                            <img class="thumb" src="/medias/@a.Id/vignette.jpg?v=@a.AnalyzedAt?.ToUnixTimeSeconds()" loading="lazy" alt="" />
                        }
                        else
                        {
                            <div class="thumb"></div>
                        }
                    </td>
                    <td>
                        @if (_editing == a.Id)
                        {
                            <input style="width:100%" @bind="a.Title" />
                        }
                        else
                        {
                            <div title="@a.Overview">@a.Title</div>
                            <div class="small muted mono" title="@a.Path">@a.FileName</div>
                        }
                        @if (a.Error is not null && a.Status != AssetStatus.Pret)
                        {
                            <div class="small" style="color:var(--live)">@a.Error</div>
                        }
                    </td>
                    <td>
                        @if (_editing == a.Id)
                        {
                            <select @bind="a.Kind">
                                @foreach (var k in Enum.GetValues<AssetKind>())
                                {
                                    <option value="@k">@Fmt.Kind(k)</option>
                                }
                            </select>
                        }
                        else
                        {
                            @Fmt.Kind(a.Kind)
                        }
                    </td>
                    <td class="num">@(a.Duration > TimeSpan.Zero ? Fmt.Duration(a.Duration) : "—")</td>
                    <td class="small">@(a.Width > 0 ? $"{a.Width}×{a.Height} · {a.FrameRate}" : "—")@(a.Status == AssetStatus.Pret && !a.HasAudio ? " · sans son" : "")</td>
                    <td class="small mono">@(a.LoudnessLufs is { } l ? $"{l:0.0} LUFS → {a.GainDb:+0.0;-0.0;0} dB" : "—")</td>
                    <td><span class="badge @css">@label</span></td>
                    <td>
                        <div class="row" style="@(CanEdit ? "" : "display:none")">
                            @if (_editing == a.Id)
                            {
                                <button class="btn sm primary" @onclick="() => SaveAssetAsync(a)">OK</button>
                            }
                            else
                            {
                                <button class="btn sm" @onclick="() => _editing = a.Id">Modifier</button>
                            }
                            <button class="btn sm" @onclick="() => ReanalyzeAsync(a.Id)" title="Relancer l'analyse">↻</button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
@if (_total > _assets.Count)
{
    <div class="row" style="margin-top:10px">
        <span class="muted">@_assets.Count sur @_total affichés</span>
        <button class="btn sm" @onclick="MoreAsync">Afficher plus</button>
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    private System.Security.Claims.ClaimsPrincipal _user = new();
    private bool CanEdit => Perm.Library(_user);
    private List<MediaFolder> _folders = new();
    private List<MediaAsset> _assets = new();
    private int _total, _limit = 100;
    private string _newPath = "";
    private AssetKind _newKind = AssetKind.Programme;
    private bool _newRecursive = true, _busy, _messageOk;
    private string? _message;
    private int? _editing;
    private bool _scanning;
    private string _jfUrl = "", _jfKey = "";
    private string? _jfServerName;
    private List<JellyfinLibrary>? _jfLibraries;
    private readonly HashSet<string> _jfSelected = new();
    private List<NetworkHost>? _hosts;
    private List<string>? _shares;
    private string _smbHost = "", _smbUser = "", _smbPassword = "", _smbSubPath = "";
    private string? _smbShare;
    private AssetKind _smbKind = AssetKind.Programme;
    private bool _smbRecursive = true;
    private DateTime _lastRefresh;

    private string Search { get; set; } = "";
    private string KindFilter { get; set; } = "";
    private string StatusFilter { get; set; } = "";

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null) _user = (await AuthState).User;
        await LoadFoldersAsync();
        await ReloadAsync();
        Library.Changed += OnLibraryChanged;
    }

    private void OnLibraryChanged()
    {
        if (_editing is not null || (DateTime.UtcNow - _lastRefresh).TotalMilliseconds < 1500) return;
        _lastRefresh = DateTime.UtcNow;
        _ = InvokeAsync(async () =>
        {
            await LoadFoldersAsync();
            await ReloadAsync();
            StateHasChanged();
        });
    }

    private async Task LoadFoldersAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _folders = await db.MediaFolders.AsNoTracking().OrderBy(f => f.Path).ToListAsync();
    }

    private async Task ReloadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var q = db.MediaAssets.AsNoTracking();
        if (!string.IsNullOrWhiteSpace(Search))
        {
            var s = $"%{Search.Trim()}%";
            q = q.Where(a => EF.Functions.Like(a.Title, s) || EF.Functions.Like(a.FileName, s));
        }
        if (Enum.TryParse<AssetKind>(KindFilter, out var kind)) q = q.Where(a => a.Kind == kind);
        if (Enum.TryParse<AssetStatus>(StatusFilter, out var status)) q = q.Where(a => a.Status == status);
        _total = await q.CountAsync();
        _assets = await q.OrderBy(a => a.Title).Take(_limit).ToListAsync();
    }

    private async Task MoreAsync()
    {
        _limit += 200;
        await ReloadAsync();
    }

    private async Task AddFolderAsync()
    {
        if (!CanEdit) return;
        _message = null;
        var path = _newPath.Trim();
        if (path.Length == 0) return;
        if (!Directory.Exists(path))
        {
            (_message, _messageOk) = ($"Le serveur ne trouve pas le dossier « {path} ». Vérifiez le chemin (et, sur Proxmox, le point de montage du conteneur).", false);
            return;
        }
        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            var full = Path.GetFullPath(path);
            if (await db.MediaFolders.AnyAsync(f => f.Path == full))
            {
                (_message, _messageOk) = ("Ce dossier est déjà dans la médiathèque.", false);
                return;
            }
            var folder = new MediaFolder { Path = full, DefaultKind = _newKind, Recursive = _newRecursive };
            db.MediaFolders.Add(folder);
            await db.SaveChangesAsync();
            _newPath = "";
            await ScanAsync(folder.Id);
        }
    }

    private async Task ScanAsync(int folderId)
    {
        if (!CanEdit) return;
        _busy = true;
        try
        {
            var (added, updated, missing) = await Library.ScanFolderAsync(folderId);
            (_message, _messageOk) = ($"Parcours terminé : {added} nouveau(x), {updated} modifié(s), {missing} absent(s). L'analyse continue en arrière-plan.", true);
        }
        catch (Exception ex)
        {
            (_message, _messageOk) = ($"Parcours impossible : {ex.Message}", false);
        }
        finally
        {
            _busy = false;
        }
        await LoadFoldersAsync();
        await ReloadAsync();
    }

    private async Task RemoveFolderAsync(int folderId)
    {
        if (!CanEdit) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var folder = await db.MediaFolders.FindAsync(folderId);
        if (folder is null) return;
        db.MediaFolders.Remove(folder);
        await db.SaveChangesAsync();
        (_message, _messageOk) = ("Dossier retiré. Ses médias restent dans la médiathèque (ils peuvent être utilisés dans des conducteurs).", true);
        await LoadFoldersAsync();
    }

    private async Task SaveAssetAsync(MediaAsset a)
    {
        if (!CanEdit) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var entity = await db.MediaAssets.FindAsync(a.Id);
        if (entity is not null)
        {
            entity.Title = string.IsNullOrWhiteSpace(a.Title) ? entity.Title : a.Title.Trim();
            entity.Kind = a.Kind;
            await db.SaveChangesAsync();
        }
        _editing = null;
    }

    private async Task ScanNetworkAsync()
    {
        if (!CanEdit) return;
        _scanning = true;
        _message = null;
        StateHasChanged();
        try
        {
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(30));
            _hosts = await Scanner.ScanAsync(cts.Token);
        }
        catch (Exception ex)
        {
            (_message, _messageOk) = ($"Recherche impossible : {ex.Message}", false);
        }
        finally
        {
            _scanning = false;
        }
    }

    private void ChooseHost(NetworkHost host)
    {
        _smbHost = host.Address;
        _shares = null;
        _smbShare = null;
    }

    private async Task ListSharesAsync()
    {
        if (!CanEdit) return;
        _message = null;
        _shares = null;
        _smbShare = null;
        _busy = true;
        try
        {
            var (host, user, pass) = (_smbHost.Trim(), _smbUser.Trim(), _smbPassword);
            _shares = await Task.Run(() =>
            {
                using var session = SmbSession.Login(host, user, pass, null);
                return session.ListShares();
            });
        }
        catch (Exception ex) when (ex is SmbException or System.Net.Sockets.SocketException or IOException)
        {
            (_message, _messageOk) = (ex.Message, false);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task AddSmbFolderAsync()
    {
        if (!CanEdit) return;
        if (_smbShare is null) return;
        _message = null;
        _busy = true;
        try
        {
            var sub = _smbSubPath.Replace('\\', '/').Trim('/');
            var target = new SmbTarget(_smbHost.Trim(), _smbShare, _smbUser.Trim(), _smbPassword);
            // Vérifie l'accès au dossier avant de l'enregistrer.
            await Task.Run(() =>
            {
                using var session = SmbSession.Open(target);
                _ = session.EnumerateFiles(sub, recursive: false, _ => false).Any();
            });

            var path = SmbSources.FolderPath(target.Host, target.Share, sub);
            int folderId;
            await using (var db = await DbFactory.CreateDbContextAsync())
            {
                if (await db.MediaFolders.AnyAsync(f => f.Path == path))
                {
                    (_message, _messageOk) = ("Ce dossier partagé est déjà dans la médiathèque.", false);
                    return;
                }
                var folder = new MediaFolder
                {
                    Path = path,
                    Source = FolderSource.Smb,
                    SmbHost = target.Host,
                    SmbShare = target.Share,
                    SmbSubPath = sub.Length == 0 ? null : sub,
                    SmbUser = target.User,
                    SmbPasswordProtected = Smb.Protect(target.Password),
                    DefaultKind = _smbKind,
                    Recursive = _smbRecursive,
                };
                db.MediaFolders.Add(folder);
                await db.SaveChangesAsync();
                folderId = folder.Id;
            }
            _smbPassword = "";
            _shares = null;
            _smbShare = null;
            _busy = false;
            await ScanAsync(folderId);
        }
        catch (Exception ex) when (ex is SmbException or System.Net.Sockets.SocketException or IOException)
        {
            (_message, _messageOk) = (ex.Message, false);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ReanalyzeAsync(int id)
    {
        if (CanEdit) await Library.ReanalyzeAsync(id);
    }

    private static string LibraryLabel(string? type) => type switch
    {
        "movies" => "films",
        "tvshows" => "séries",
        "musicvideos" => "clips",
        "homevideos" => "vidéos",
        null => "mixte",
        _ => type,
    };

    private void ToggleLibrary(string id, bool on)
    {
        if (on) _jfSelected.Add(id); else _jfSelected.Remove(id);
    }

    private async Task ConnectJellyfinAsync()
    {
        if (!CanEdit) return;
        _message = null;
        _jfLibraries = null;
        _jfSelected.Clear();
        _busy = true;
        try
        {
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(20));
            var client = Smb.Jellyfin(_jfUrl, _jfKey.Trim());
            _jfServerName = await client.ServerNameAsync(cts.Token);
            _jfLibraries = (await client.LibrariesAsync(cts.Token))
                .Where(l => l.CollectionType is null or "movies" or "tvshows" or "musicvideos" or "homevideos" or "mixed")
                .ToList();
            foreach (var l in _jfLibraries.Where(l => l.CollectionType is "movies" or "tvshows")) _jfSelected.Add(l.Id);
            _jfUrl = client.BaseUrl;
        }
        catch (Exception ex) when (ex is JellyfinException or UriFormatException or InvalidOperationException or OperationCanceledException)
        {
            (_message, _messageOk) = (ex is OperationCanceledException ? "Le serveur Jellyfin ne répond pas." : ex.Message, false);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ImportJellyfinAsync()
    {
        if (!CanEdit) return;
        if (_jfLibraries is null) return;
        _busy = true;
        _message = null;
        var ids = new List<int>();
        try
        {
            await using (var db = await DbFactory.CreateDbContextAsync())
            {
                foreach (var lib in _jfLibraries.Where(l => _jfSelected.Contains(l.Id)))
                {
                    var path = SmbSources.JellyfinFolderPath(_jfUrl, lib.Id);
                    var existing = await db.MediaFolders.FirstOrDefaultAsync(f => f.Path == path);
                    if (existing is not null)
                    {
                        // Même bibliothèque : on met simplement à jour la clé.
                        existing.RemoteKeyProtected = Smb.Protect(_jfKey.Trim());
                        existing.RemoteUrl = _jfUrl;
                        ids.Add(existing.Id);
                        continue;
                    }
                    var folder = new MediaFolder
                    {
                        Path = path,
                        Source = FolderSource.Jellyfin,
                        RemoteUrl = _jfUrl,
                        RemoteKeyProtected = Smb.Protect(_jfKey.Trim()),
                        RemoteLibraryId = lib.Id,
                        RemoteLibraryName = lib.Name,
                        DefaultKind = lib.CollectionType == "tvshows" ? AssetKind.Episode : lib.CollectionType == "movies" ? AssetKind.Film : AssetKind.Programme,
                    };
                    db.MediaFolders.Add(folder);
                    await db.SaveChangesAsync();
                    ids.Add(folder.Id);
                }
                await db.SaveChangesAsync();
            }
            int added = 0, updated = 0;
            foreach (var id in ids)
            {
                var (a, u, _) = await Library.ScanFolderAsync(id);
                added += a;
                updated += u;
            }
            (_message, _messageOk) = ($"Jellyfin : {added} film(s) / épisode(s) ajouté(s), {updated} mis à jour. L'analyse (volume, vignettes) continue en arrière-plan.", true);
            _jfLibraries = null;
            _jfKey = "";
        }
        catch (Exception ex) when (ex is JellyfinException or IOException)
        {
            (_message, _messageOk) = (ex.Message, false);
        }
        finally
        {
            _busy = false;
        }
        await LoadFoldersAsync();
        await ReloadAsync();
    }

    public void Dispose() => Library.Changed -= OnLibraryChanged;
}
