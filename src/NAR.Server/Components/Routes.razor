<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
            <NotAuthorized>
                @if (context.User.Identity?.IsAuthenticated == true)
                {
                    <h1>Accès réservé</h1>
                    <p class="lead">Votre rôle (@context.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value) ne permet pas d'ouvrir cette page. <a href="/">Retour à l'antenne</a></p>
                }
                else
                {
                    <RedirectToLogin />
                }
            </NotAuthorized>
        </AuthorizeRouteView>
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(Layout.MainLayout)">
            <h1>Page introuvable</h1>
            <p class="lead">Cette page n'existe pas. <a href="/">Retour à l'antenne</a></p>
        </LayoutView>
    </NotFound>
</Router>
